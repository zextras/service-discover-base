[Unit]
Description=Zextras SPIRE OIDC Discovery Provider
Documentation=https://spiffe.io/docs/latest/
After=spire-server.service
Requires=spire-server.service
ConditionPathExists=/etc/zextras/spire/oidc-discovery-provider.conf
PartOf=service-discover.target

[Service]
Type=simple
User=spire-server
Group=spire-server
ExecStart=/usr/bin/spire-oidc-discovery-provider -config /etc/zextras/spire/oidc-discovery-provider.conf
Restart=on-failure
RestartSec=5s
StateDirectory=spire/oidc-discovery-provider
StateDirectoryMode=0700

# Hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=service-discover.target
