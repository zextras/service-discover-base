# `consul connect envoy` refuses Envoy versions outside the range compiled
# into Consul (envoyextensions/xdscommon/ENVOY_VERSIONS): Consul 2.1.x
# accepts Envoy 1.36 - 1.39. Keep the envoyproxy conflict below and the
# service-discover-base conflict in zextras/envoyproxy in sync.
#   - https://developer.hashicorp.com/consul/docs/connect/proxies/envoy

pkgname="service-discover-base"
pkgver="2.1.0" # renovate: datasource=github-releases depName=hashicorp/consul
pkgrel="1"
pkgdesc="Service discover binary, based on HashiCorp Consul"
maintainer="Zextras <packages@zextras.com>"
arch=('aarch64' 'x86_64')
license=("MPL-2.0")
section="admin"
priority="optional"
url="https://www.zextras.com/"
conflicts=(
  "consul"
  "envoyproxy<1.36.0"
)
source=(
  "https://github.com/hashicorp/consul/archive/v${pkgver}.tar.gz"
  "service-discover.target"
  "service-discover-wrapper.sh"
  "systemd-sysuser.conf"
)

sha256sums=(
  '208087b8f4d546cd186849ebfa162b5a34703dbdc5ee75f96d061177690f7b8d'
  'd5c95901ad8cb5245cb460ebcb597af10005a7ee13cd00618e47ffda882675ac'
  'ad222d3d5f8474a48ec8fe1827512ab78285e0be84e065a7b3037abcfeb58bb9'
  'ee3f2413084b52f5cfa310ce5e1311d86283848e5405cad992365dfea1db80ce'
)

build() {
  cd "${srcdir}/consul-${pkgver}"

  # consul is incompatible with -buildmode=pie
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  # hashicorpmetrics: keep Raft, Serf and Memberlist metrics, as upstream
  # release builds do since Consul 2.0.
  CGO_ENABLED=0 \
    go build -tags=hashicorpmetrics -ldflags="-s -w"
}

_package_legacy() {
  cd "${srcdir}/consul-${pkgver}"

  install -Dm755 consul \
    "${pkgdir}/usr/bin/consul"

  install -Dm755 "${srcdir}/service-discover-wrapper.sh" \
    "${pkgdir}/usr/bin/service-discover-wrapper.sh"

  install -Dm644 "${srcdir}/systemd-sysuser.conf" \
    "${pkgdir}/usr/lib/sysusers.d/service-discover.conf"
}

_package_systemd() {
  cd "${srcdir}/consul-${pkgver}"

  install -Dm755 consul \
    "${pkgdir}/usr/bin/consul"

  install -Dm755 "${srcdir}/service-discover-wrapper.sh" \
    "${pkgdir}/usr/bin/service-discover-wrapper.sh"

  install -Dm644 "${srcdir}/service-discover.target" \
    "${pkgdir}/lib/systemd/system/service-discover.target"

  install -Dm644 "${srcdir}/systemd-sysuser.conf" \
    "${pkgdir}/usr/lib/sysusers.d/service-discover.conf"
}

_postinst_legacy() {
  systemd-sysusers /usr/lib/sysusers.d/service-discover.conf >/dev/null 2>&1 || :
}

_postinst_systemd() {
  systemd-sysusers /usr/lib/sysusers.d/service-discover.conf >/dev/null 2>&1 || :
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    systemctl enable service-discover.target &>/dev/null || :
  fi
}

_prerm_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable --now service-discover.target &>/dev/null || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
  fi
}

package() {
  _package_systemd
}

package__rocky_8() {
  _package_legacy
}

package__rocky_9() {
  _package_systemd
}

package__ubuntu_jammy() {
  _package_legacy
}

package__ubuntu_noble() {
  _package_systemd
}

postinst__rocky_8() {
  _postinst_legacy
}

postinst__rocky_9() {
  _postinst_systemd
}

postinst__ubuntu_jammy() {
  _postinst_legacy
}

postinst__ubuntu_noble() {
  _postinst_systemd
}

prerm__rocky_9() {
  _prerm_systemd
}

prerm__ubuntu_noble() {
  _prerm_systemd
}
