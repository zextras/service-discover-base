[Unit]
Description=Zextras SPIRE Agent
Documentation=https://spiffe.io/docs/latest/
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zextras/spire/agent.conf
PartOf=service-discover.target

[Service]
Type=simple
User=spire-agent
Group=spire-agent
ExecStart=/usr/bin/spire-agent run -config /etc/zextras/spire/agent.conf
Restart=on-failure
RestartSec=5s
StateDirectory=spire/agent
StateDirectoryMode=0700
# The Workload API socket must be reachable by every service user: the agent
# identifies the caller from the socket peer credentials.
RuntimeDirectory=spire/agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0027

# Hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=service-discover.target
